# Env / secrets — never commit (git-flow-convention.md §8)
.env
.env.*
!.env.example

# Node (Frontend, Mobile)
node_modules/
.next/
dist/
build/
.expo/
*.log
*.tsbuildinfo

# Python (Backend)
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Design canvas exports (large, generated, view-only — not source)
Design/mockups/
Document/
# Test coverage artifacts
.coverage
coverage.xml
htmlcov/
coverage/

# Personal working notes — read locally, not part of the deliverable.
# Shared team files stay tracked: list them below as exceptions.
# `Document/*` rather than `Document/`: git cannot re-include a file whose
# parent directory is itself excluded, so the negation would be ignored.
Document/*
!Document/*.xlsx
