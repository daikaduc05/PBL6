# Use the Session Pooler host (Supabase dashboard -> Connect -> Session
# pooler), NOT the direct-connection host. The direct host
# (db.<ref>.supabase.co) is IPv6-only unless you pay for the IPv4 add-on,
# so it fails to resolve/connect from most local networks and from Docker
# Desktop on Windows/Mac. Session pooler behaves like a normal persistent
# connection (unlike Transaction pooler, which breaks asyncpg's prepared
# statements) and has an IPv4 address. Note the username changes to
# postgres.<project-ref> for the pooler.
#
# No `?options=-csearch_path=...` either way — asyncpg's connect() doesn't
# accept an `options` kwarg the way psycopg2 does (SQLAlchemy passes URL
# query params straight through and asyncpg rejects it). Schema isolation
# instead comes from every model declaring `schema="account"` in
# __table_args__, so generated SQL is always fully-qualified
# (`account.users`, ...) regardless of search_path.
DATABASE_URL=postgresql+asyncpg://postgres.naypwavhrtzylupgfcyd:CHANGE_ME@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-random-32-byte-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

ENV=local
LOG_LEVEL=INFO
