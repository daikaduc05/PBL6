# Points only at the `account` schema — search_path restricts this service
# to its own bounded context even on a shared Supabase Postgres instance.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db.naypwavhrtzylupgfcyd.supabase.co:5432/postgres?options=-csearch_path%3Daccount

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-random-32-byte-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

ENV=local
LOG_LEVEL=INFO
