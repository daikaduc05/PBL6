# Same Supabase project/credentials as every other service — schema
# isolation comes from models declaring schema="payment" in __table_args__,
# not from the connection string (see Backend/services/account/.env.example
# for why: asyncpg rejects the ?options=-csearch_path=... trick, and the
# direct-connection host is IPv6-only on the free tier so use Session
# Pooler here too).
DATABASE_URL=postgresql+asyncpg://postgres.naypwavhrtzylupgfcyd:CHANGE_ME@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-random-32-byte-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

ENV=local
LOG_LEVEL=INFO
