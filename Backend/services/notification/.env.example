# ---------------------------------------------------------------------------
# notification service (M2) — copy to .env and fill in the real values.
# .env is gitignored. NEVER commit it: DATABASE_URL carries the Supabase
# password, which grants access to every schema of the shared database.
# ---------------------------------------------------------------------------

# --- Database (shared Supabase project, schema "notification") --------------
# Pooler host (IPv4-friendly, recommended). Note the user is postgres.<ref>:
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Direct connection (IPv6 only on the free plan):
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

DB_SCHEMA=notification
DB_POOL_SIZE=5

# The Supabase pooler runs in transaction mode, where asyncpg's prepared
# statements break with DuplicatePreparedStatementError. Keep this true unless
# you connect directly to db.<ref>.supabase.co.
DB_DISABLE_STATEMENT_CACHE=true

# --- Service ---------------------------------------------------------------
PORT=8005
DEBUG=false

# --- Cross-schema reads (see spec §0.4) ------------------------------------
# Read-only SELECTs against account / content / learning schemas, isolated in
# readers.py. Set false once Hà's internal HTTP endpoints exist.
ALLOW_CROSS_SCHEMA_READ=true

# --- Messaging / cache (filled in at T16 and reco-cache) -------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
REDIS_URL=redis://localhost:6379/0

# --- Email (T15) -----------------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@pbl6.dev
EMAIL_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Feature flags / tuning ------------------------------------------------
REMINDER_CRON_ENABLED=true
REMINDER_HOUR=20
REMINDER_TIMEZONE=Asia/Ho_Chi_Minh

# Score thresholds for the rule-based recommender. highest_score is assumed to
# be on a 0-100 scale — confirm with Hà (spec §B.1).
RECO_SCORE_SCALE=100
RECO_PROMOTE_SCORE=80
RECO_REVIEW_SCORE=50
RECO_CACHE_TTL_SECONDS=900
