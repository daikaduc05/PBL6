# Use the Session Pooler host (Supabase dashboard -> Connect -> Session
# pooler), NOT the direct-connection host. The direct host
# (db.<ref>.supabase.co) is IPv6-only unless you pay for the IPv4 add-on, so
# it fails to connect from most local networks and from Docker Desktop on
# Windows/Mac. Session pooler behaves like a normal persistent connection
# (unlike Transaction pooler, which breaks asyncpg's prepared statements) and
# has an IPv4 address. Note the username changes to postgres.<project-ref>.
#
# No `?options=-csearch_path=...` — asyncpg's connect() does not accept an
# `options` kwarg. Schema isolation comes from every model declaring
# schema="notification" in __table_args__, so generated SQL is always
# fully-qualified (notification.messages, ...) regardless of search_path.
DATABASE_URL=postgresql+asyncpg://postgres.naypwavhrtzylupgfcyd:CHANGE_ME@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Required by pbl6_common.BaseServiceSettings. This service never issues or
# verifies tokens — the gateway does — but the shared settings class demands it.
JWT_SECRET=change-me-to-a-random-32-byte-string

ENV=local
LOG_LEVEL=INFO

# --- Study reminder, function 8.1 (T14) ---
REMINDER_CRON_ENABLED=true
REMINDER_HOUR=20
REMINDER_TIMEZONE=Asia/Ho_Chi_Minh

# --- Email, function 8.1 (T15) ---
# Dev uses Mailpit (docker compose), which accepts anything on port 1025 and
# shows the result at http://localhost:8025 without sending real mail.
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@pbl6.dev
EMAIL_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Recommendation (T17) ---
# learning.histories.highest_score is a bare double; a 0-100 scale is assumed
# pending Hà's confirmation (notif_spec §B.1).
RECO_SCORE_SCALE=100
RECO_PROMOTE_SCORE=80
RECO_REVIEW_SCORE=50
RECO_CACHE_TTL_SECONDS=900
