ENV=local
LOG_LEVEL=INFO

# Supabase Postgres — one schema per service (Backend/db/README.md). Each
# service's own .env sets its own `search_path` in the query string, e.g.
# services/account/.env.example. This root file is a template only.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db.naypwavhrtzylupgfcyd.supabase.co:5432/postgres

# Local Redis (docker compose up -d redis) — refresh-token denylist, rate limiting
REDIS_URL=redis://localhost:6379/0

# RabbitMQ — not needed until events are wired (T26)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

JWT_SECRET=change-me-to-a-random-32-byte-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
