# frontend.md's own spec assumes a single gateway (NEXT_PUBLIC_API_BASE_URL)
# in front of all six services — that's task T08/T09, not built yet. Until
# it lands, this app's own Next.js route handlers (src/app/api/**) act as
# the temporary gateway stand-in: they read the session cookie, extract
# X-User-Id/X-User-Roles from the JWT, and call each backend service
# directly by its own URL. Swap these two for one NEXT_PUBLIC_API_BASE_URL
# once the gateway exists — nothing else in this app needs to change,
# since lib/api-client.ts is the only place that reads these.
ACCOUNT_SERVICE_URL=http://localhost:8001/api/v1
PAYMENT_SERVICE_URL=http://localhost:8004/api/v1

SESSION_COOKIE_NAME=pbl6_session
# Must match JWT_SECRET/JWT_ALGORITHM in Backend/services/account/.env —
# this app verifies the access token itself (no gateway to do it for us
# yet) before trusting its claims.
SESSION_JWT_SECRET=change-me-to-a-random-32-byte-string
SESSION_JWT_ALGORITHM=HS256
